    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JF.AgenticEnterprise.Infrastructure\JF.AgenticEnterprise.Infrastructure.csproj" />
  </ItemGroup>
</Project>
