    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JF.AgenticEnterprise.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.*" />
